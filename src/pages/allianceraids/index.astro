---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FightCard from '../../components/FightCard.astro';
import { expansions } from '../../lib/expansions';

const allAllianceRaids = await getCollection('allianceraids');

// Sort by level, then by title
const sortedRaids = allAllianceRaids.sort((a, b) => {
  if (a.data.level !== b.data.level) {
    return a.data.level - b.data.level;
  }
  return a.data.title.localeCompare(b.data.title);
});

// Group by expansion
const raidsByExpansion = sortedRaids.reduce((acc, raid) => {
  const exp = raid.data.expansion;
  if (!acc[exp]) acc[exp] = [];
  acc[exp].push(raid);
  return acc;
}, {} as Record<string, typeof sortedRaids>);

const expansionOrder = ['arr', 'hw', 'sb', 'shb', 'ew', 'dt'] as const;
---

<BaseLayout title="Alliance Raids">
  <h1>Alliance Raids</h1>
  <p class="page-description">24-player raids featuring epic battles and unique storylines.</p>
  
  {sortedRaids.length === 0 ? (
    <p>No alliance raids added yet. Check back soon!</p>
  ) : (
    expansionOrder.map(exp => {
      const raids = raidsByExpansion[exp];
      if (!raids || raids.length === 0) return null;
      
      return (
        <section>
          <div class="section-header">
            <h2 class="section-title">{expansions[exp].name}</h2>
            <span class="section-count">{raids.length} raids</span>
          </div>
          <div class="fights-grid">
            {raids.map(raid => (
              <FightCard
                title={raid.data.title}
                slug={raid.id}
                type="allianceraids"
                expansion={raid.data.expansion}
                difficulty={raid.data.difficulty}
                level={raid.data.level}
                bosses={raid.data.bosses}
              />
            ))}
          </div>
        </section>
      );
    })
  )}
</BaseLayout>

<style>
  .page-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }
</style>
