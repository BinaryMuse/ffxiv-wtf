---
import { getCollection, render } from 'astro:content';
import FightLayout from '../../layouts/FightLayout.astro';

export async function getStaticPaths() {
  const allianceraids = await getCollection('allianceraids');
  return allianceraids.map((raid) => ({
    params: { slug: raid.id },
    props: { raid },
  }));
}

const { raid } = Astro.props;
const { Content } = await render(raid);
---

<FightLayout
  title={raid.data.title}
  expansion={raid.data.expansion}
  difficulty={raid.data.difficulty}
  level={raid.data.level}
  minIlvl={raid.data.minIlvl}
  bosses={raid.data.bosses}
  type="alliance raid"
>
  <Content />
</FightLayout>
