---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FightCard from '../../components/FightCard.astro';
import { expansions } from '../../lib/expansions';

const allTrials = await getCollection('trials');

// Sort by level, then by difficulty, then by title
const difficultyOrder = { normal: 0, hard: 1, extreme: 2, savage: 3, ultimate: 4 };
const sortedTrials = allTrials.sort((a, b) => {
  if (a.data.level !== b.data.level) {
    return a.data.level - b.data.level;
  }
  const diffA = difficultyOrder[a.data.difficulty] ?? 0;
  const diffB = difficultyOrder[b.data.difficulty] ?? 0;
  if (diffA !== diffB) {
    return diffA - diffB;
  }
  return a.data.title.localeCompare(b.data.title);
});

// Group by expansion
const trialsByExpansion = sortedTrials.reduce((acc, trial) => {
  const exp = trial.data.expansion;
  if (!acc[exp]) acc[exp] = [];
  acc[exp].push(trial);
  return acc;
}, {} as Record<string, typeof sortedTrials>);

const expansionOrder = ['arr', 'hw', 'sb', 'shb', 'ew', 'dt'] as const;
---

<BaseLayout title="Trials">
  <h1>Trials</h1>
  
  {sortedTrials.length === 0 ? (
    <p>No trials added yet. Check back soon!</p>
  ) : (
    expansionOrder.map(exp => {
      const trials = trialsByExpansion[exp];
      if (!trials || trials.length === 0) return null;
      
      return (
        <section>
          <div class="section-header">
            <h2 class="section-title">{expansions[exp].name}</h2>
            <span class="section-count">{trials.length} trials</span>
          </div>
          <div class="fights-grid">
            {trials.map(trial => (
              <FightCard
                title={trial.data.title}
                slug={trial.id}
                type="trials"
                expansion={trial.data.expansion}
                difficulty={trial.data.difficulty}
                level={trial.data.level}
                bosses={trial.data.bosses}
              />
            ))}
          </div>
        </section>
      );
    })
  )}
</BaseLayout>
