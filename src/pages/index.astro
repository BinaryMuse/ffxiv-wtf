---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FightCard from "../components/FightCard.astro";
import { expansions } from "../lib/expansions";

const allDungeons = await getCollection("dungeons");
const allTrials = await getCollection("trials");
const allRaids = await getCollection("raids");
const allAllianceRaids = await getCollection("allianceraids");

// Combine all content for search
const allContent = [
  ...allDungeons.map((d) => ({ ...d, contentType: "dungeons" as const })),
  ...allTrials.map((t) => ({ ...t, contentType: "trials" as const })),
  ...allRaids.map((r) => ({ ...r, contentType: "raids" as const })),
  ...allAllianceRaids.map((r) => ({ ...r, contentType: "allianceraids" as const })),
];

const highLevelContent = allContent.filter((item) => item.data.level >= 100);

// Count by type
const counts = {
  dungeons: allDungeons.length,
  trials: allTrials.length,
  raids: allRaids.length,
  allianceraids: allAllianceRaids.length,
  total: allContent.length,
};

// Serialize content for client-side search and filtering
const searchData = allContent.map((item) => ({
  title: item.data.title,
  slug: item.id,
  type: item.contentType,
  expansion: item.data.expansion,
  level: item.data.level,
  difficulty: item.data.difficulty,
  bosses: item.data.bosses.map((b) => b.name),
}));

// Expansion data for client-side
const expansionData = expansions;
---

<BaseLayout title="Home">
  <div class="hero">
    <h1>FFXIV.wtf</h1>
    <p class="hero-subtitle">
      Quick reference notes for FFXIV dungeons, trials, and raids
    </p>
  </div>

  <div class="search-container">
    <input
      type="text"
      class="search-input"
      placeholder="Search fights by name, boss, or expansion (ARR, SHB, etc.)"
      id="search-input"
      autofocus="true"
    />
    <div id="search-results" class="search-results" style="display: none;">
    </div>
  </div>

  <div class="browse-section">
    <h2>Browse by Content Type</h2>
    <div class="browse-grid">
      <a href="/dungeons" class="browse-card">
        <span class="browse-icon">🏰</span>
        <span class="browse-title">Dungeons</span>
        <span class="browse-count">{counts.dungeons} fights</span>
      </a>
      <a href="/trials" class="browse-card">
        <span class="browse-icon">⚔️</span>
        <span class="browse-title">Trials</span>
        <span class="browse-count">{counts.trials} fights</span>
      </a>
      <a href="/raids" class="browse-card">
        <span class="browse-icon">👥</span>
        <span class="browse-title">Raids</span>
        <span class="browse-count">{counts.raids} fights</span>
      </a>
      <a href="/allianceraids" class="browse-card">
        <span class="browse-icon">🛡️</span>
        <span class="browse-title">Alliance Raids</span>
        <span class="browse-count">{counts.allianceraids} fights</span>
      </a>
    </div>
  </div>

  <div class="browse-section">
    <h2>Browse by Expansion</h2>
    <div class="filter-tabs" id="expansion-filters">
      {
        Object.entries(expansions).map(([key, exp]) => (
          <button
            type="button"
            data-expansion={key}
            class={`filter-tab expansion-${key}`}
          >
            {exp.shortName}
          </button>
        ))
      }
      <button
        type="button"
        class="filter-tab clear-filter"
        id="clear-expansion"
        style="display: none;"
      >
        Clear
      </button>
    </div>
  </div>

  <section class="recent-section" id="filtered-section" style="display: none;">
    <div class="section-header">
      <h2 class="section-title" id="filtered-title"></h2>
      <span class="section-count" id="filtered-count"></span>
    </div>
    <div class="fights-grid" id="filtered-grid"></div>
  </section>

  <section class="recent-section" id="default-section">
    <div class="section-header">
      <h2 class="section-title">High-Level Content</h2>
    </div>
    <div class="fights-grid">
      {
        highLevelContent.map((item) => (
          <FightCard
            title={item.data.title}
            slug={item.id}
            type={item.contentType}
            expansion={item.data.expansion}
            difficulty={item.data.difficulty}
            level={item.data.level}
            bosses={item.data.bosses}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<script define:vars={{ searchData, expansionData }}>
  const searchInput = document.getElementById("search-input");
  const searchResults = document.getElementById("search-results");

  if (searchInput && searchResults) {
    searchInput.addEventListener("input", (e) => {
      const query = e.target.value.toLowerCase().trim();

      if (query.length < 2) {
        searchResults.style.display = "none";
        return;
      }

      const results = searchData
        .filter((item) => {
          const searchText = [item.title, ...item.bosses, item.expansion]
            .join(" ")
            .toLowerCase();
          return searchText.includes(query);
        })
        .slice(0, 8);

      if (results.length === 0) {
        searchResults.innerHTML =
          '<div class="search-no-results">No results found</div>';
      } else {
        searchResults.innerHTML = results
          .map(
            (item) => `
          <a href="/${item.type}/${item.slug}" class="search-result-item">
            <span class="search-result-title">${item.title}</span>
            <span class="search-result-meta">
              <span class="meta-tag expansion-${item.expansion}">${item.expansion.toUpperCase()}</span>
              <span class="meta-tag">Lv${item.level}</span>
            </span>
          </a>
        `,
          )
          .join("");
      }

      searchResults.style.display = "flex";
    });

    // Hide results when clicking outside
    document.addEventListener("click", (e) => {
      if (
        !searchInput.contains(e.target) &&
        !searchResults.contains(e.target)
      ) {
        searchResults.style.display = "none";
      }
    });
  }

  // Expansion filtering
  const expansionFilters = document.getElementById("expansion-filters");
  const clearButton = document.getElementById("clear-expansion");
  const filteredSection = document.getElementById("filtered-section");
  const defaultSection = document.getElementById("default-section");
  const filteredTitle = document.getElementById("filtered-title");
  const filteredCount = document.getElementById("filtered-count");
  const filteredGrid = document.getElementById("filtered-grid");

  let activeExpansion = null;

  function renderFilteredContent(expansion) {
    const filtered = searchData
      .filter((item) => item.expansion === expansion)
      .sort((a, b) => a.level - b.level);

    const expInfo = expansionData[expansion];
    filteredTitle.textContent = `${expInfo.name} Content`;
    filteredCount.textContent = `${filtered.length} fights`;

    filteredGrid.innerHTML = filtered
      .map(
        (item) => `
      <a href="/${item.type}/${item.slug}" class="fight-card">
        <div class="fight-card-header">
          <span class="meta-tag expansion-${item.expansion}">${item.expansion.toUpperCase()}</span>
          <span class="meta-tag">Lv${item.level}</span>
        </div>
        <h3 class="fight-card-title">${item.title}</h3>
        <div class="fight-card-bosses">
          ${item.bosses
            .slice(0, 3)
            .map((b) => `<span class="boss-name">${b}</span>`)
            .join("")}
          ${item.bosses.length > 3 ? `<span class="boss-more">+${item.bosses.length - 3} more</span>` : ""}
        </div>
      </a>
    `,
      )
      .join("");
  }

  function setActiveExpansion(expansion) {
    // Update active states on buttons
    document
      .querySelectorAll("#expansion-filters .filter-tab")
      .forEach((btn) => {
        btn.classList.remove("active");
      });

    if (expansion) {
      const activeBtn = document.querySelector(
        `[data-expansion="${expansion}"]`,
      );
      if (activeBtn) activeBtn.classList.add("active");
      clearButton.style.display = "inline-block";

      renderFilteredContent(expansion);
      filteredSection.style.display = "block";
      defaultSection.style.display = "none";
    } else {
      clearButton.style.display = "none";
      filteredSection.style.display = "none";
      defaultSection.style.display = "block";
    }

    activeExpansion = expansion;
  }

  if (expansionFilters) {
    expansionFilters.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-expansion]");
      if (btn) {
        const expansion = btn.dataset.expansion;
        setActiveExpansion(expansion === activeExpansion ? null : expansion);
      }
    });
  }

  if (clearButton) {
    clearButton.addEventListener("click", () => {
      setActiveExpansion(null);
    });
  }
</script>

<style>
  .hero {
    text-align: center;
    padding: var(--space-2xl) 0;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .hero-subtitle-large {
    color: var(--text-primary);
    font-size: 1.5em;
    border-bottom: none;
  }

  .hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.25rem;
  }

  .search-container {
    position: relative;
    max-width: 500px;
    margin: 0 auto var(--space-2xl);
  }

  .search-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-top: none;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    max-height: 400px;
    overflow-y: auto;
    z-index: 50;
    display: flex;
    flex-direction: column;
  }

  :global(.search-result-item) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    margin: 0.5rem;
    border-radius: 8px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    text-decoration: none;
    flex-shrink: 0;
  }

  :global(.search-result-item:hover) {
    background: #2d333b;
  }

  :global(.search-result-title) {
    font-weight: 500;
  }

  :global(.search-result-meta) {
    display: flex;
    gap: var(--space-xs);
  }

  :global(.search-no-results) {
    padding: var(--space-md);
    color: var(--text-muted);
    text-align: center;
  }

  .browse-section {
    margin-bottom: var(--space-2xl);
  }

  .browse-section h2 {
    margin-top: 0;
    border-bottom: none;
    padding-bottom: 0;
  }

  .browse-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
  }

  .browse-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.15s ease;
  }

  .browse-card:hover {
    border-color: var(--accent-color);
    transform: translateY(-2px);
  }

  .browse-icon {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }

  .browse-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .browse-count {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .filter-tabs .filter-tab {
    color: white;
    border: none;
  }

  .filter-tabs .expansion-arr {
    background: var(--expansion-arr);
  }
  .filter-tabs .expansion-hw {
    background: var(--expansion-hw);
  }
  .filter-tabs .expansion-sb {
    background: var(--expansion-sb);
  }
  .filter-tabs .expansion-shb {
    background: var(--expansion-shb);
  }
  .filter-tabs .expansion-ew {
    background: var(--expansion-ew);
  }
  .filter-tabs .expansion-dt {
    background: var(--expansion-dt);
  }

  .recent-section {
    margin-top: var(--space-xl);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }
  }
</style>
