---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Quick reference for FFXIV dungeons, trials, and raids",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | FFXIV.wtf</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-content">
        <a href="/" class="site-title">FFXIV.wtf</a>
        <Navigation />
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-content">
        <p class="footer-disclaimer">
          FINAL FANTASY XIV © SQUARE ENIX CO., LTD. All Rights Reserved.
        </p>
        <p class="footer-credits">
          Built with ♥ by <a
            href="https://github.com/BinaryMuse"
            target="_blank"
            rel="noopener">BinaryMuse</a
          > using <a href="https://astro.build" target="_blank" rel="noopener"
            >Astro</a
          > ·
          <a
            href="https://github.com/BinaryMuse/ffxiv-wtf"
            target="_blank"
            rel="noopener">View on GitHub</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
