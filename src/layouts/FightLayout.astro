---
import BaseLayout from './BaseLayout.astro';
import { expansions } from '../lib/expansions';

interface Props {
  title: string;
  expansion: keyof typeof expansions;
  difficulty: string;
  level: number;
  minIlvl?: number;
  bosses: { name: string }[];
  type: 'dungeon' | 'trial' | 'raid' | 'alliance raid';
}

const { title, expansion, difficulty, level, minIlvl, bosses, type } = Astro.props;
const expansionInfo = expansions[expansion];

// Capitalize first letter of type for display
const typeDisplay = type.charAt(0).toUpperCase() + type.slice(1);
---

<BaseLayout title={title}>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="fight-meta">
        <span class={`meta-tag expansion expansion-${expansion}`}>
          {expansionInfo.name}
        </span>
        <span class="meta-tag">{typeDisplay}</span>
        <span class="meta-tag">Lv{level}</span>
        {minIlvl && <span class="meta-tag">iLvl {minIlvl}</span>}
        {difficulty !== 'normal' && (
          <span class={`meta-tag difficulty-${difficulty}`}>
            {difficulty.charAt(0).toUpperCase() + difficulty.slice(1)}
          </span>
        )}
      </div>
    </header>
    
    <div class="prose">
      <slot />
    </div>
    
    <div class="report-link">
      <a href={`https://github.com/BinaryMuse/ffxiv-wtf/issues/new?template=incorrect-info.yml&title=${encodeURIComponent(`[Correction]: ${title}`)}`} target="_blank" rel="noopener">
        See something wrong? Report incorrect info
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .report-link {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-color);
  }
  
  .report-link a {
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  
  .report-link a:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }
</style>

<script>
  // Color-code mechanic types in tables
  const mechanicColors: Record<string, string> = {
    tankbuster: 'var(--mechanic-tankbuster)',
    raidwide: 'var(--mechanic-raidwide)',
    stack: 'var(--mechanic-stack)',
    spread: 'var(--mechanic-spread)',
    gaze: 'var(--mechanic-gaze)',
    knockback: 'var(--mechanic-knockback)',
    cleave: 'var(--mechanic-cleave)',
    aoe: 'var(--mechanic-aoe)',
    enrage: 'var(--mechanic-enrage)',
  };

  document.querySelectorAll('.prose table strong').forEach((el) => {
    const text = el.textContent?.toLowerCase().trim() || '';
    const color = mechanicColors[text];
    if (color) {
      (el as HTMLElement).style.color = color;
    }
  });
</script>
